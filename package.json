{
  "name": "eterra-survivors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Survivors-like spin-off set in the world of Crônicas de Eterra",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lab": "LAB=1 vitest run tests/lab/weapons.test.ts --silent=false",
    "sim": "SIM=1 vitest run tests/lab/sim.test.ts --silent=false",
    "newplayer": "NEWPLAYER=1 vitest run tests/lab/newplayer.test.ts --silent=false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
